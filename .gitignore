.DS_Store
.env
.env.local
.env.*.local

# Source video masters — only the optimized mvl-video-1-web-10s.mp4 is committed.
# Patterns are path-agnostic so they survive the site living under mvl/.
*.mov
mvl-video-1-web.mp4
scripts/bin/facebox

# Player photo sources: RAW/HEIC originals, the background-removed cut-outs,
# and the renamed working set. ~4.5GB, and nothing on the site loads them —
# scripts/player-photos.py builds from these and uploads the WebPs to the
# mvl-player-photos Supabase bucket, which is what the pages actually fetch.
mvl/assets/player-photos/

# Roster reveal masters: 2160x2700 PNGs, ~97MB. scripts build the WebPs in
# mvl/assets/teams/roster/, which is what the lightbox loads.
mvl/assets/team-photos/

# Scratch and working files. Holds DB exports with participant emails and
# phone numbers — must never be committed.
tmp/
